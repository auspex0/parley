{
  "name": "parley-room",
  "version": "1.2.0",
  "private": false,
  "description": "Multi-agent chat room for you, Claude Code, and Codex - runs locally, using the CLI sessions you're already signed into.",
  "type": "module",
  "bin": {
    "parley": "parley.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node parley.mjs",
    "test": "node test/smoke.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:browser": "playwright test --config test/browser.config.mjs",
    "test:unit": "node --test test/unit.mjs",
    "test:retry": "node test/retry.mjs",
    "test:automatic": "node test/automatic.mjs",
    "test:provenance": "node test/provenance.mjs",
    "test:sequences": "node test/scheduler-sequences.mjs",
    "bench": "node test/benchmark.mjs",
    "test:integration": "npm run test:retry && npm run test:provenance && npm run test:sequences && npm run test:automatic",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:smoke && npm run test:browser && npm run test:package",
    "test:package": "node test/package.mjs"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auspex0/parley.git"
  },
  "homepage": "https://github.com/auspex0/parley#readme",
  "keywords": [
    "claude-code",
    "codex",
    "cli",
    "multi-agent",
    "chat"
  ],
  "files": [
    "parley.mjs",
    "lib/",
    "ui/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
